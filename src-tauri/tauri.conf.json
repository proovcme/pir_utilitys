{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Калькулятор оценки проекта",
  "version": "0.1.0",
  "identifier": "com.local.project-estimate-calculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Калькулятор оценки проекта",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Калькулятор оценки стоимости проекта",
    "longDescription": "Настольный калькулятор оценки стоимости проектных работ с шаблонами, историей и выгрузкой Excel."
  }
}
